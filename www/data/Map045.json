{"id":2,"name":"EV002","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":111,"indent":0,"parameters":[4,1,3,19]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["Нет ничего проще, чем сделать бомбу дома.\\!"]},{"code":401,"indent":1,"parameters":["Ищешь метод изготовления в интернете"]},{"code":401,"indent":1,"parameters":["и следуешь инструкции шаг за шагом. Бомба готова."]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["Но, говоря консервативно, если у тебя есть огнестрел,"]},{"code":401,"indent":1,"parameters":["нет никакой причины останавливаться на этой мощи."]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["Так что я начала размышлять над созданием чего-то более"]},{"code":401,"indent":1,"parameters":["крутого. \\!Исследовав применения бомб в прошлом, я"]},{"code":401,"indent":1,"parameters":["хотела создать такую взрывчатку, которая составила бы"]},{"code":401,"indent":1,"parameters":["им хорошую конкуренцию."]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["Даже когда я дошла до химического синтеза взрывчатых"]},{"code":401,"indent":1,"parameters":["веществ, останавливаться было рано."]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["Вообще, мне не особо хотелось использовать в создании"]},{"code":401,"indent":1,"parameters":["бомб жидкость для снятия лака и детергенты."]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["После парочки экспериментов, я получила три типа бомб.\\!"]},{"code":401,"indent":1,"parameters":["Оправдает ли их мощь мои усилия?\\!"]},{"code":401,"indent":1,"parameters":["Уже не терпится узнать."]},{"code":0,"indent":1,"parameters":[]},{"code":411,"indent":0,"parameters":[]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["Я изготовила несколько самодельных бомб.\\!"]},{"code":401,"indent":1,"parameters":["Хоть они мне и не сильно нужны, покуда есть огнестрел,\\!"]},{"code":401,"indent":1,"parameters":["но не взять с собой парочку было бы упущением."]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["Необходимые для производства знания я получила в"]},{"code":401,"indent":1,"parameters":["интернете. \\!В то же время, на пользу пошло множество"]},{"code":401,"indent":1,"parameters":["статей и видео о террористах."]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["Мне незнакомо желание убивать друг друга во имя религии.\\!"]},{"code":401,"indent":1,"parameters":["Бог? Рай? Душа?"]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["Зачем это всё."]},{"code":0,"indent":1,"parameters":[]},{"code":412,"indent":0,"parameters":[]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":5,"y":7},
{"id":3,"name":"EV003","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Отсюда видна школа.\\!"]},{"code":401,"indent":0,"parameters":["Школа, столь ненавистная мной."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Печально, но пока моя жизнь стремительно рушилась,"]},{"code":401,"indent":0,"parameters":["этот вид никак не менялся."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Каждый звонок знаменовал скорое появление школьников,"]},{"code":401,"indent":0,"parameters":["во всё горло смеющихся над моим несчастьем."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["…Но всему рано или поздно настанет конец.\\!"]},{"code":401,"indent":0,"parameters":["С этого дня мы станем настоящими друзьями.\\!"]},{"code":401,"indent":0,"parameters":["И будем страдать все вместе."]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":8,"y":4},
