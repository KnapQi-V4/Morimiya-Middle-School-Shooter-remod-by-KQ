rameters":["Сегодня был самый обычный школьный день."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Я ни с кем не говорю и не играю,"]},{"code":401,"indent":0,"parameters":["предпочитая тихо сидеть за своей партой.\\!"]},{"code":401,"indent":0,"parameters":["После школы пойду прямиком домой."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Так и прошли в этой школе два моих года."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Спроси я одноклассников, что они обо мне думают, —"]},{"code":401,"indent":0,"parameters":["какие бы получила ответы?"]},{"code":221,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["",0,0,1]},{"code":401,"indent":0,"parameters":["«Выглядит честной»,\\. «Хмурый ребёнок»,\\."]},{"code":401,"indent":0,"parameters":["«Почти незаметна»,\\. «Вечно одна»."]},{"code":222,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Так все на меня и смотрят.\\!"]},{"code":401,"indent":0,"parameters":["Для них это и есть вся я."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["...От того бы и удивились,\\!"]},{"code":401,"indent":0,"parameters":["если бы узнали, что моё сердце переполнено злобой и"]},{"code":401,"indent":0,"parameters":["ненавистью по отношению к ним."]},{"code":232,"indent":0,"parameters":[4,0,0,0,0,0,100,100,0,0,30,true]},{"code":246,"indent":0,"parameters":[2]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["И что более важно......"]},{"code":221,"indent":0,"parameters":[]},{"code":230,"indent":0,"parameters":[60]},{"code":101,"indent":0,"parameters":["",0,0,1]},{"code":401,"indent":0,"parameters":["Если бы узнали, что я хочу всех убить..."]},{"code":222,"indent":0,"parameters":[]},{"code":230,"indent":0,"parameters":[60]},{"code":101,"indent":0,"parameters":["",0,0,2]